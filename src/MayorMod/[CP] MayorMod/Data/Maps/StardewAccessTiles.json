{
    "Changes": [
        {
            "LogName": "Adding Stardew Access tile names for voting booths in CommunityCenter",
            "Action": "EditData",
            "Target": "shoaib.stardewaccess/AccessibleTilesData",
            "Entries": {
                "{{ModId}}_CommunityCenterVotingDay": {
                    "Maps": [
                        {
                            "Id": "CommunityCenter",
                            "Tiles": [
                                { "DisplayName": "{{i18n:{{ModId}}_AccessibleTiles.BallotDesk}}", "X": [ 23 ], "Y": [ 11 ], "Category": "interactables" },
                                { "DisplayName": "{{i18n:{{ModId}}_AccessibleTiles.VotingBooth}}", "X": [ 25, 26, 27, 28 ], "Y": [ 9 ], "Category": "interactables" },
                                { "DisplayName": "{{i18n:{{ModId}}_AccessibleTiles.BallotBox}}", "X": [ 29, 30 ], "Y": [ 8 ], "Category": "interactables" }
                            ]
                        }
                    ]
                }
            },
            "When": {
                "HasFlag: hostPlayer | contains={{ModId}}_VotingDay": true,
                "HasVotingInCommunityCenter": true
            }
        },
